# Salin file ini menjadi ".env" lalu isi API key kamu.
# JANGAN PERNAH commit file ".env" ke git — hanya ".env.example" (tanpa isi asli) yang boleh di-push.
#
# Minimal isi SATU provider agar bot bisa menjawab. Semakin banyak yang diisi,
# semakin tahan fallback-nya saat satu provider kena rate limit.

# https://console.groq.com/keys
GROQ_API_KEY=

# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# --- Fase 2: Secure Webhook Agent ---
# Token bebas kamu tentukan sendiri (bukan dari provider manapun) -- ini yang
# harus dikirim n8n lewat header "Authorization: Bearer <nilai ini>".
# Generate token acak yang aman, contoh: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_API_TOKEN=
